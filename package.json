{
	"name": "disjsx",
	"version": "1.1.2",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"sideEffects": false,
	"devDependencies": {
		"@types/bun": "latest",
		"eslint": "9.24.0",
		"eslint-plugin-prefer-arrow": "^1.2.3",
		"eslint-plugin-react-compiler": "^19.0.0-beta-e993439-20250405",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"typescript-eslint": "^8.29.1",
		"react": "^19.0.0",
		"@types/react": "^19.0.0",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"description": "A library for creating Discord messages in JSX",
	"files": [
		"dist"
	],
	"license": "MIT",
	"private": false,
	"scripts": {
		"build:types": "tsc --project ./tsconfig.build.json",
		"check:types": "! grep -rEn '(from |import\\()\"\\.\\.?/[^\"]*\"' dist/types | grep -v '\\.js\"'",
		"clean": "rm -rf dist",
		"build": "bun run clean && bun run build:js && bun run build:types && bun run check:types",
		"test": "bun test",
		"format": "bunx prettier --write .",
		"lint": "bunx eslint .",
		"lint:fix": "bunx eslint --fix .",
		"release": "npm publish",
		"build:js": "bun build ./src/index.ts --outdir ./dist --sourcemap --target node --format esm --packages external",
		"typecheck": "tsc -p tsconfig.build.json --noEmit",
		"prepublishOnly": "bun run typecheck && bun run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Santa-Paws/disjsx.git"
	},
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"keywords": [
		"discord",
		"jsx",
		"discord.js",
		"discord.ts",
		"discord.jsx",
		"discord.tsx"
	]
}
